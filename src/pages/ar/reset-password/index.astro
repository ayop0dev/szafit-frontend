---
/**
 * TODO (Module 6.3): Implement POST /api/reset-password proxy endpoint.
 * Payload:   { key: string, id: string, login: string, password: string }
 * Response:  { success: boolean, message?: string }
 * The client script below POSTs to that path; until it exists, failed requests
 * surface the WhatsApp support link to the user.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSiteSettings } from '../../../lib/content';

const currentPath = Astro.url.pathname;
const siteSettings = getSiteSettings();
const whatsappHref = `https://wa.me/${siteSettings.whatsappNumber.replace(/\D/g, '')}`;
---

<BaseLayout lang="ar" title="إعادة تعيين كلمة المرور — SZAFIT" currentPath={currentPath}>
  <main class="flex-1 bg-surface-soft flex items-center justify-center py-16 px-6">
    <div class="w-full max-w-md" dir="rtl">

      <!-- Icon -->
      <div class="flex justify-center mb-6">
        <div class="w-16 h-16 rounded-2xl bg-primary/20 border border-primary/30 flex items-center justify-center">
          <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"
               class="text-accent" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25z"/>
          </svg>
        </div>
      </div>

      <div class="text-center mb-8">
        <h1 class="text-2xl lg:text-3xl font-bold text-text mb-2">إعادة تعيين كلمة المرور</h1>
        <p class="text-text-muted text-sm leading-relaxed">
          أدخل كلمة المرور الجديدة لحسابك في SZAFIT.
        </p>
      </div>

      <!-- Invalid link state (shown when key/id/login missing) -->
      <div id="invalid-state" class="hidden">
        <div class="bg-surface border border-error-border/30 rounded-2xl p-8 text-center shadow-card-resting">
          <div class="w-12 h-12 rounded-full bg-error-bg flex items-center justify-center mx-auto mb-4">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"
                 class="text-error-text" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"/>
              <path stroke-linecap="round" d="M12 8v4m0 4h.01"/>
            </svg>
          </div>
          <h2 class="text-lg font-bold text-text mb-2">رابط غير صالح أو منتهي الصلاحية</h2>
          <p class="text-sm text-text-muted mb-6 leading-relaxed">
            رابط إعادة التعيين هذا غير صالح أو انتهت صلاحيته.
            يمكنك طلب رابط جديد من صفحة نسيت كلمة المرور.
          </p>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-primary text-on-primary px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-primary-hover transition-all hover:-translate-y-0.5"
          >
            تواصل مع الدعم
          </a>
        </div>
      </div>

      <!-- Reset form (shown when key/id/login are present) -->
      <div id="form-state" class="hidden">
        <div class="bg-surface border border-border rounded-2xl p-8 shadow-card-resting">

          <!-- Hidden token fields — populated by client script -->
          <form id="reset-form" novalidate>
            <input type="hidden" id="field-key"   name="key"   value="" />
            <input type="hidden" id="field-id"    name="id"    value="" />
            <input type="hidden" id="field-login" name="login" value="" />

            <!-- New password -->
            <div class="mb-5">
              <label for="password" class="block text-sm font-semibold text-text mb-2">
                كلمة المرور الجديدة
              </label>
              <input
                type="password"
                id="password"
                name="password"
                autocomplete="new-password"
                required
                minlength="8"
                class="w-full bg-base border border-border rounded-xl px-4 py-3 text-text placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                placeholder="أدخل كلمة مرور قوية"
              />
            </div>

            <!-- Confirm password -->
            <div class="mb-6">
              <label for="password-confirm" class="block text-sm font-semibold text-text mb-2">
                تأكيد كلمة المرور
              </label>
              <input
                type="password"
                id="password-confirm"
                name="password_confirm"
                autocomplete="new-password"
                required
                minlength="8"
                class="w-full bg-base border border-border rounded-xl px-4 py-3 text-text placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                placeholder="أعد إدخال كلمة المرور"
              />
            </div>

            <!-- Validation error -->
            <div id="form-error" class="hidden mb-4 p-3 bg-error-bg border border-error-border/30 rounded-xl text-sm text-error-text text-center"></div>

            <!-- Submit -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-primary text-on-primary py-3.5 rounded-xl font-bold hover:bg-primary-hover transition-all hover:-translate-y-0.5 shadow-sm disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:translate-y-0"
            >
              <span id="submit-label">تعيين كلمة المرور الجديدة</span>
              <span id="submit-loading" class="hidden">جارٍ المعالجة...</span>
            </button>
          </form>

          <!-- Success state -->
          <div id="success-state" class="hidden text-center py-4">
            <div class="w-14 h-14 rounded-full bg-primary/20 flex items-center justify-center mx-auto mb-4">
              <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5"
                   class="text-accent" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5"/>
              </svg>
            </div>
            <h2 class="text-lg font-bold text-text mb-2">تم تعيين كلمة المرور بنجاح</h2>
            <p class="text-sm text-text-muted mb-6">يمكنك الآن تسجيل الدخول عبر التطبيق بكلمة مرورك الجديدة.</p>
            <a href="/ar/" class="inline-flex items-center gap-2 bg-primary text-on-primary px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-primary-hover transition-all hover:-translate-y-0.5">
              العودة للرئيسية
            </a>
          </div>

        </div>

        <!-- Support footer -->
        <p class="text-center text-xs text-text-muted mt-4">
          تحتاج مساعدة؟
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer"
             class="text-accent font-medium hover:underline">تواصل مع الدعم</a>
        </p>
      </div>

    </div>
  </main>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var params  = new URLSearchParams(window.location.search);
    var key     = params.get('key')   || '';
    var id      = params.get('id')    || '';
    var login   = params.get('login') || '';

    var invalidEl = document.getElementById('invalid-state');
    var formEl    = document.getElementById('form-state');

    // A valid reset link must have key, id, and login
    if (!key || !id || !login) {
      if (invalidEl) invalidEl.classList.remove('hidden');
      return;
    }

    // Populate hidden fields
    var fKey   = document.getElementById('field-key');
    var fId    = document.getElementById('field-id');
    var fLogin = document.getElementById('field-login');
    if (fKey)   fKey.value   = key;
    if (fId)    fId.value    = id;
    if (fLogin) fLogin.value = login;

    if (formEl) formEl.classList.remove('hidden');

    // Form submission
    var form        = document.getElementById('reset-form');
    var submitBtn   = document.getElementById('submit-btn');
    var submitLabel = document.getElementById('submit-label');
    var submitLoad  = document.getElementById('submit-loading');
    var errorEl     = document.getElementById('form-error');
    var successEl   = document.getElementById('success-state');

    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (errorEl) errorEl.classList.add('hidden');

      var password        = document.getElementById('password').value;
      var passwordConfirm = document.getElementById('password-confirm').value;

      if (password.length < 8) {
        if (errorEl) { errorEl.textContent = 'يجب أن تكون كلمة المرور 8 أحرف على الأقل.'; errorEl.classList.remove('hidden'); }
        return;
      }
      if (password !== passwordConfirm) {
        if (errorEl) { errorEl.textContent = 'كلمة المرور وتأكيدها غير متطابقتين.'; errorEl.classList.remove('hidden'); }
        return;
      }

      // Show loading state
      if (submitBtn)   submitBtn.disabled  = true;
      if (submitLabel) submitLabel.classList.add('hidden');
      if (submitLoad)  submitLoad.classList.remove('hidden');

      // TODO: Replace '/api/reset-password' with the live proxy endpoint once available.
      // Expected payload: { key, id, login, password }
      // Expected response: { success: boolean, message?: string }
      fetch('/api/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: key, id: id, login: login, password: password }),
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data.success) {
            if (form)      form.classList.add('hidden');
            if (successEl) successEl.classList.remove('hidden');
          } else {
            throw new Error(data.message || 'فشلت العملية');
          }
        })
        .catch(function () {
          if (submitBtn)   submitBtn.disabled  = false;
          if (submitLabel) submitLabel.classList.remove('hidden');
          if (submitLoad)  submitLoad.classList.add('hidden');
          if (errorEl) {
            errorEl.textContent = 'تعذّر إكمال العملية. تواصل مع الدعم عبر واتساب إذا استمرت المشكلة.';
            errorEl.classList.remove('hidden');
          }
        });
    });
  });
</script>
