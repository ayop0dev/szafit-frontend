---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TextPageTemplate from '../../../components/pages/TextPageTemplate.astro';
import { getPageContent } from '../../../lib/content';

const currentPath = Astro.url.pathname;
const pageContent = getPageContent('privacy');
const titleEn = (pageContent as any).titleEn;
---

<BaseLayout lang="en" title={`${titleEn} — SZAFIT`} currentPath={currentPath} showNav>
  <TextPageTemplate lang="en" page="privacy" />
</BaseLayout>
