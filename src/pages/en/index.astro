---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import TestimonialsCarousel from '../../components/TestimonialsCarousel.astro';
import FinalCta from '../../components/FinalCta.astro';
import AppStoreButtons from '../../components/AppStoreButtons.astro';
import { getAllPrograms } from '../../lib/content';

const programs = getAllPrograms();
const currentPath = Astro.url.pathname;
---

<BaseLayout lang="en" title="SZAFIT | Complete Fitness System" currentPath={currentPath} showNav>
  <main class="flex-1 bg-base text-text">

    <!-- Section 01: Hero -->
    <section class="relative bg-base glow-hero overflow-hidden pt-5 lg:pt-6 pb-12 lg:pb-20">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-10 h-full flex flex-col items-center justify-start relative">
            <div class="z-10 text-center flex flex-col items-center gap-2.5 w-full max-w-5xl mx-auto px-2">
                <span class="bg-primary text-on-primary px-4 py-1.5 rounded-full text-[12px] lg:text-[13px] font-bold tracking-normal animate-fade-up shadow-sm">Complete Fitness System</span>
                
                <h1 class="text-[32px] lg:text-[48px] xl:text-[54px] font-[800] text-text leading-[1.2] animate-fade-up">
                    Transform Your Body Into an Athletic Masterpiece
                </h1>
                
                <div class="flex flex-col gap-1.5 mt-2 mx-auto w-full max-w-full justify-center items-center">
                    <p class="text-[22px] md:text-[28px] lg:text-[32px] font-black text-text animate-fade-up delay-200" style="animation-fill-mode: both;">Invest in your health today with Coach SZA.</p>
                    <p class="text-[12px] md:text-[15px] lg:text-[17px] font-medium text-text-muted animate-fade-up delay-200" style="animation-fill-mode: both;">Premium custom training and nutrition programs via the app for elites and fitness enthusiasts.</p>
                </div>
            </div>

            <div class="z-20 mt-8 lg:mt-10 relative flex justify-center w-full max-w-5xl animate-fade-up delay-200 pb-0" style="animation-fill-mode: both;">
                <div class="relative w-[260px] lg:w-[320px] xl:w-[340px] z-20 hero-slider">
                    <!-- Base image to set height -->
                    <img src="/assets/images/app-screenshots/welcome.webp" alt="App Welcome Base" class="w-full h-auto drop-shadow-2xl object-contain opacity-100">
                    <!-- Slider images -->
                    <img src="/assets/images/app-screenshots/welcome.webp" alt="App Screen" class="absolute inset-0 w-full h-full object-contain drop-shadow-2xl slide-img">
                    <img src="/assets/images/app-screenshots/dashboard.webp" alt="App Screen" class="absolute inset-0 w-full h-full object-contain drop-shadow-2xl slide-img">
                    <img src="/assets/images/app-screenshots/programs.webp" alt="App Screen" class="absolute inset-0 w-full h-full object-contain drop-shadow-2xl slide-img">
                    <img src="/assets/images/app-screenshots/single-program.webp" alt="App Screen" class="absolute inset-0 w-full h-full object-contain drop-shadow-2xl slide-img">
                    <img src="/assets/images/app-screenshots/diet.webp" alt="App Screen" class="absolute inset-0 w-full h-full object-contain drop-shadow-2xl slide-img">
                    <img src="/assets/images/app-screenshots/meals.webp" alt="App Screen" class="absolute inset-0 w-full h-full object-contain drop-shadow-2xl slide-img">
                </div>
                
                <div class="absolute top-[10%] start-[5%] lg:-start-[5%] xl:-start-[2%] z-30 animate-[floatDemo_3s_ease-in-out_infinite_alternate] delay-[0.8s] bg-surface p-3 lg:p-4 rounded-[16px] lg:rounded-[20px] shadow-card-resting flex items-center gap-3 transition-transform hover:scale-105 cursor-default flex-row-reverse text-right">
                    <div class="bg-primary/20 text-accent p-2 rounded-full"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg></div>
                    <div class="text-left">
                        <div class="text-[12px] lg:text-[14px] font-bold text-text">Workout Completed</div>
                        <div class="text-[11px] lg:text-[12px] text-text-faint">Today</div>
                    </div>
                </div>

                <div class="hidden lg:flex absolute top-[40%] lg:start-[0%] xl:-start-[2%] z-30 animate-[floatDemo_3s_ease-in-out_infinite_alternate] bg-surface p-4 rounded-[20px] shadow-card-resting items-center gap-3 transition-transform hover:scale-105 cursor-default">
                    <div class="text-accent"><svg width="24" height="24" fill="currentColor"><path d="M12 2c0 0-5 6-5 10a5 5 0 0010 0c0-4-5-10-5-10z"/></svg></div>
                    <div>
                        <div class="text-[14px] font-bold text-text">Calories Burned</div>
                        <div class="text-[14px] font-bold text-text">450 kcal</div>
                    </div>
                </div>

                <div class="hidden lg:flex absolute top-[70%] lg:start-[5%] xl:start-[5%] z-30 animate-[floatDemo_3s_ease-in-out_infinite_alternate] delay-[1.6s] bg-surface p-4 rounded-[20px] shadow-card-resting items-center gap-3 transition-transform hover:scale-105 cursor-default">
                    <div class="text-accent text-2xl">🔥</div>
                    <div>
                        <div class="text-[14px] font-bold text-text">Activity Streak</div>
                        <div class="text-[14px] font-bold text-text">18 days</div>
                    </div>
                </div>
                
                <div class="absolute top-[20%] end-[5%] lg:-end-[5%] xl:-end-[2%] z-30 animate-[floatDemo_3s_ease-in-out_infinite_alternate] delay-[1.6s] bg-surface p-3 lg:p-4 rounded-[16px] lg:rounded-[20px] shadow-card-resting flex items-center gap-3 transition-transform hover:scale-105 cursor-default">
                    <img src="/assets/images/coach-sza/coach-sza (7).webp" alt="Coach" class="w-8 h-8 lg:w-10 lg:h-10 rounded-full object-cover border-2 border-surface">
                    <div class="text-left">
                        <div class="text-[12px] lg:text-[14px] font-bold text-text">Coach's Message</div>
                        <div class="text-[11px] lg:text-[12px] text-text-muted max-w-[100px] truncate">Excellent! Let's inc...</div>
                    </div>
                </div>

                <div class="hidden lg:flex absolute top-[50%] lg:end-[-2%] xl:-end-[2%] z-30 animate-[floatDemo_3s_ease-in-out_infinite_alternate] delay-[0.8s] bg-surface p-4 rounded-[20px] shadow-card-resting items-center gap-3 transition-transform hover:scale-105 cursor-default">
                    <div class="w-10 h-10 rounded-full border-4 border-border border-t-primary flex items-center justify-center text-[12px] font-bold">85%</div>
                    <div>
                        <div class="text-[14px] font-bold text-text">Nutrition Progress</div>
                    </div>
                </div>

                <div class="hidden lg:flex absolute top-[80%] lg:end-[5%] xl:end-[5%] z-30 animate-[floatDemo_3s_ease-in-out_infinite_alternate] bg-surface p-4 rounded-[20px] shadow-card-resting items-center gap-3 transition-transform hover:scale-105 cursor-default">
                    <div class="text-accent"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>
                    <div>
                        <div class="text-[14px] font-bold text-text">Weekly Check-in</div>
                        <div class="text-[12px] text-accent font-medium">Completed</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 02: Trust Strip -->
    <section class="bg-surface-soft border-y border-border py-8">
        <div class="max-w-[1280px] mx-auto px-6 grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-0 lg:divide-x lg:divide-border">
            <div class="flex flex-col lg:flex-row items-center justify-center gap-2 lg:gap-4 text-center lg:text-start animate-fade-up">
                <svg class="text-accent shrink-0" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
                <div class="flex items-center justify-center gap-2 flex-wrap">
                    <div class="text-[16px] lg:text-[20px] font-[700] text-text">1,200+</div>
                    <div class="text-[16px] lg:text-[20px] font-[700] text-text">Active Members</div>
                </div>
            </div>
            <div class="flex flex-col lg:flex-row items-center justify-center gap-2 lg:gap-4 text-center lg:text-start animate-fade-up delay-[100ms]" style="animation-fill-mode: both;">
                <svg class="text-accent shrink-0" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                <div class="flex items-center justify-center gap-2 flex-wrap">
                    <div class="text-[16px] lg:text-[20px] font-[700] text-text">4</div>
                    <div class="text-[16px] lg:text-[20px] font-[700] text-text">Specialized Programs</div>
                </div>
            </div>
            <div class="flex flex-col lg:flex-row items-center justify-center gap-2 lg:gap-4 text-center lg:text-start animate-fade-up delay-[200ms]" style="animation-fill-mode: both;">
                <svg class="text-accent shrink-0" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
                <div>
                    <div class="text-[16px] lg:text-[20px] font-[700] text-text">Complete Mobile App</div>
                </div>
            </div>
            <div class="flex flex-col lg:flex-row items-center justify-center gap-2 lg:gap-4 text-center lg:text-start animate-fade-up delay-[300ms]" style="animation-fill-mode: both;">
                <svg class="text-accent shrink-0" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                <div>
                    <div class="text-[16px] lg:text-[20px] font-[700] text-text">Direct Coach Support</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 03: Programs -->
    <section id="programs" class="bg-base py-14 lg:py-20">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-10">
            <div class="mb-12 animate-fade-up">
                <div class="flex flex-row justify-between items-center mb-4">
                    <span class="bg-primary text-on-primary px-3 py-1 rounded-full text-[12px] font-[600] shrink-0">Our Programs</span>
                    <a href="/en/programs/" class="text-accent font-medium hover:underline flex items-center gap-2 transition-transform hover:translate-x-1 text-[14px] shrink-0">View All Programs <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
                </div>
                <h2 class="text-[30px] lg:text-[40px] font-[700] leading-[1.2]">Choose Your Fitness Path</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                {programs.map((p) => (
                    <ProgramCard program={p} lang="en" />
                ))}
            </div>
        </div>
    </section>

    <!-- Section 05: App Experience -->
    <section id="app" class="bg-base py-14 lg:py-20 overflow-hidden">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-10">
            <div class="mb-12 animate-fade-up">
                <span class="bg-primary text-on-primary px-3 py-1 rounded-full text-[12px] font-[600]">App Experience</span>
                <h2 class="text-[30px] lg:text-[40px] font-[700] mt-4 leading-[1.2]">Athletic Performance on Your Phone</h2>
                <p class="text-[16px] lg:text-[18px] text-text-muted mt-4 max-w-2xl leading-[1.65]">An advanced, intuitive interface providing everything you need to stay committed and hit your daily goals.</p>
            </div>

            <div class="flex lg:grid overflow-x-auto lg:overflow-visible snap-x snap-mandatory lg:snap-none gap-4 lg:grid-cols-4 pb-12 lg:pb-0 hide-scrollbar px-6 lg:px-0 -mx-6 lg:mx-0">
                {[ 
                    { label: 'Access', webm: '/assets/videos/login.webm', poster: '', title: 'Easy Platform Access', desc: 'A convenient interface to log in and access all your programs easily and quickly.' },
                    { label: 'Weekly Check-ins', webm: '/assets/videos/program2.webm', poster: '/assets/images/app-screenshots/meals.webp', title: 'Reports & Tracking', desc: 'Submit your measurements and progress photos to the coach for necessary plan adjustments.' },
                    { label: 'Nutrition', webm: '/assets/videos/diet.webm', poster: '/assets/images/app-screenshots/diet.webp', title: 'Calorie Tracking', desc: 'Log your daily meals and ensure you hit your protein and calorie targets precisely.' },
                    { label: 'Workouts', webm: '/assets/videos/program.webm', poster: '/assets/images/app-screenshots/single-program.webp', title: 'Smart Workout Tracking', desc: 'Log every set and rep accurately, and track your weights weekly to ensure continuous progress.' }
                ].map((c, i) => (
                    <div class="snap-start shrink-0 w-[85vw] sm:w-[280px] lg:w-auto bg-surface p-4 lg:p-5 rounded-[20px] shadow-card-resting flex flex-col gap-4 lg:gap-5 animate-fade-up hover:-translate-y-1 transition-transform duration-300" style={`animation-delay: ${i*100}ms; animation-fill-mode: both;`}>
                        <span class="self-start bg-primary text-on-primary px-3 py-1 rounded-full text-[11px] lg:text-[12px] font-[600] shadow-sm">{c.label}</span>
                        <div class="flex-1 flex flex-col items-center justify-center">
                            <video class="w-full rounded-[16px] lg:rounded-[20px] aspect-[9/19] object-cover" autoplay muted loop playsinline poster={c.poster || undefined}>
                                <source src={c.webm} type="video/webm" />
                            </video>
                        </div>
                        <div>
                            <h3 class="text-[17px] lg:text-[18px] font-[700] text-text mb-2 whitespace-nowrap overflow-hidden text-ellipsis">{c.title}</h3>
                            <p class="text-[13px] lg:text-[14px] text-text-muted line-clamp-2 leading-[1.6]">{c.desc}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Section 06: Meet Coach SZA -->
    <section id="coach" class="bg-surface-soft pt-14 pb-14 lg:pt-20 lg:pb-20 border-t border-border overflow-hidden">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-10">
            <div class="flex flex-col lg:grid lg:grid-cols-[5fr_auto_3fr] gap-8 lg:gap-12 items-center">
                
                <div class="w-full order-2 lg:order-2 animate-fade-up delay-[100ms]" style="animation-fill-mode: both;">
                    <img src="/assets/images/coach-sza/coach-sza (5).webp" alt="Coach SZA" class="w-full h-auto max-h-[400px] lg:max-h-[600px] object-contain drop-shadow-[0_20px_30px_rgba(0,0,0,0.15)] transition-transform duration-500 hover:scale-105">
                </div>

                <div class="w-full order-1 lg:order-1 animate-fade-up delay-[200ms] relative" style="animation-fill-mode: both;">
                    <!-- Floating decorative elements -->
                    <div class="hidden lg:block absolute -top-8 -start-8 text-primary/20 animate-[floatDemo_4s_ease-in-out_infinite_alternate] z-0">
                        <svg width="40" height="40" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15 9l7 1-5 5 1 7-7-4-7 4 1-7-5-5 7-1z"/></svg>
                    </div>
                    <div class="hidden lg:block absolute bottom-12 -end-4 text-accent/20 animate-[floatDemo_3s_ease-in-out_infinite_alternate-reverse] z-0" style="animation-delay: 500ms;">
                        <svg width="30" height="30" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                    </div>

                    <div class="relative z-10">
                        <span class="bg-primary text-on-primary px-3 py-1 rounded-full text-[12px] font-[600]">Meet Your Coach</span>
                        <h2 class="text-[30px] lg:text-[40px] font-[700] mt-4 leading-[1.2]">Coach SZA</h2>
                        <p class="text-[16px] lg:text-[18px] text-text-muted mt-4 leading-[1.65]">Coach SZA is a Level 4 certified personal trainer. I am here to focus on inner strength before outward appearance. I believe balance is more important than perfection, and that every body deserves unique care.</p>
                        <p class="text-[16px] lg:text-[18px] text-text-muted mt-4 leading-[1.65] font-medium border-l-4 border-primary pl-4">"I provide fitness and nutrition programs to help you become stronger health-wise, physically, and spiritually. Your journey with me is not just an exercise routine... it's a lifestyle."</p>
                        <a href="https://wa.me/+966550150445" target="_blank" rel="noopener noreferrer" class="inline-block mt-8 bg-primary text-on-primary px-8 py-3 rounded-xl font-semibold hover:bg-primary-hover shadow-sm transition-transform hover:-translate-y-1">Book Consultation</a>
                    </div>
                </div>

                <div class="w-full order-3 lg:order-3 grid grid-cols-2 gap-4 lg:flex lg:flex-col lg:gap-6 mt-8 lg:mt-0 animate-fade-up">
                    <div class="bg-primary text-center p-4 lg:p-6 rounded-[20px] shadow-card-resting transition-transform hover:scale-105 lg:w-[80%] lg:self-start">
                        <div class="text-[30px] lg:text-[40px] font-[800] text-on-primary leading-none mb-1 animate-counter" data-target="8" data-suffix="+">8+</div>
                        <div class="text-[14px] font-[500] text-on-primary opacity-80">Years Experience</div>
                    </div>
                    <div class="bg-surface text-center p-4 lg:p-6 rounded-[20px] shadow-card-resting transition-transform hover:scale-105 lg:w-[80%] lg:self-end">
                        <div class="text-[30px] lg:text-[40px] font-[800] text-text leading-none mb-1">Level 4</div>
                        <div class="text-[14px] font-[500] text-text-muted">Training Level</div>
                    </div>
                    <div class="bg-text text-center p-4 lg:p-6 rounded-[20px] shadow-card-resting transition-transform hover:scale-105 lg:w-[80%] lg:self-start">
                        <div class="text-[30px] lg:text-[40px] font-[800] text-surface leading-none mb-1 animate-counter" data-target="500" data-suffix="+">500+</div>
                        <div class="text-[14px] font-[500] text-surface opacity-80">Successful Transformations</div>
                    </div>
                    <div class="bg-accent text-center p-4 lg:p-6 rounded-[20px] shadow-card-resting transition-transform hover:scale-105 lg:w-[80%] lg:self-end">
                        <div class="text-[30px] lg:text-[40px] font-[800] text-surface leading-none mb-1 animate-counter" data-target="1200" data-suffix="+">1,200+</div>
                        <div class="text-[14px] font-[500] text-surface opacity-80">Women Served</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 04: Results & Statistics -->
    <section class="bg-surface-soft py-14 lg:py-24 border-y border-border">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-10">
            <div class="text-center mb-12 lg:mb-16 animate-fade-up">
                <span class="bg-primary text-on-primary px-3 py-1 rounded-full text-[12px] font-[600]">Results</span>
                <h2 class="text-[30px] lg:text-[40px] font-[700] mt-4 leading-[1.2]">Achievements that reflect strength and commitment</h2>
            </div>
            
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 items-start pb-6 lg:pb-12">
                <div class="bg-surface p-6 lg:p-8 rounded-[20px] shadow-card-resting text-center animate-fade-up">
                    <div class="w-12 h-12 rounded-full bg-primary/20 text-accent mx-auto flex items-center justify-center mb-4">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <div class="text-[36px] lg:text-[56px] font-[800] text-text leading-none mb-2 animate-counter" style="font-variant-numeric: tabular-nums;" data-target="1200" data-suffix="+">1,200+</div>
                    <div class="text-[14px] font-[500] text-text-muted">Total Active Members</div>
                </div>
                <div class="bg-surface p-6 lg:p-8 rounded-[20px] shadow-card-resting text-center mt-6 lg:mt-16 animate-fade-up delay-[100ms]" style="animation-fill-mode: both;">
                    <div class="w-12 h-12 rounded-full bg-primary/20 text-accent mx-auto flex items-center justify-center mb-4">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline><polyline points="17 18 23 18 23 12"></polyline></svg>
                    </div>
                    <div class="text-[36px] lg:text-[56px] font-[800] text-text leading-none mb-2 animate-counter" style="font-variant-numeric: tabular-nums;" data-target="8400" data-suffix="+">8,400+</div>
                    <div class="text-[14px] font-[500] text-text-muted">Kg Total Weight Lost</div>
                </div>
                <div class="bg-surface p-6 lg:p-8 rounded-[20px] shadow-card-resting text-center animate-fade-up delay-[200ms]" style="animation-fill-mode: both;">
                    <div class="w-12 h-12 rounded-full bg-primary/20 text-accent mx-auto flex items-center justify-center mb-4">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
                    </div>
                    <div class="text-[36px] lg:text-[56px] font-[800] text-text leading-none mb-2 animate-counter" style="font-variant-numeric: tabular-nums;" data-target="94" data-suffix="%">94%</div>
                    <div class="text-[14px] font-[500] text-text-muted">Program Completion Rate</div>
                </div>
                <div class="bg-surface p-6 lg:p-8 rounded-[20px] shadow-card-resting text-center mt-6 lg:mt-16 animate-fade-up delay-[300ms]" style="animation-fill-mode: both;">
                    <div class="w-12 h-12 rounded-full bg-primary/20 text-accent mx-auto flex items-center justify-center mb-4">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                    </div>
                    <div class="text-[36px] lg:text-[56px] font-[800] text-text leading-none mb-2 animate-counter" style="font-variant-numeric: tabular-nums;" data-target="1500" data-suffix="+">1,500+</div>
                    <div class="text-[14px] font-[500] text-text-muted">Community Members</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 07: Transformation Gallery -->
    <section id="transformations" class="bg-primary py-14 lg:py-20 overflow-hidden">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-10">
            <div class="mb-12 animate-fade-up">
                <span class="bg-on-primary text-primary px-3 py-1 rounded-full text-[12px] font-[600]">Transformations</span>
                <h2 class="text-[30px] lg:text-[40px] font-[700] mt-4 leading-[1.2] text-on-primary">Real transformation stories from elite members</h2>
