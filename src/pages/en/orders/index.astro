---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSiteSettings } from '../../../lib/content';

const currentPath = Astro.url.pathname;
const siteSettings = getSiteSettings();
const whatsappHref = `https://wa.me/${siteSettings.whatsappNumber.replace(/\D/g, '')}`;
---

<BaseLayout lang="en" title="My Orders — SZAFIT" currentPath={currentPath} showNav>
  <main class="flex-1 bg-surface-soft">
    <div class="max-w-container mx-auto px-6 py-16 lg:py-28" dir="ltr">
      <div class="max-w-2xl mx-auto">

        <!-- Page header -->
        <div class="text-center mb-12">
          <div class="flex justify-center mb-6">
            <div class="w-20 h-20 rounded-full bg-primary/15 border-2 border-primary/25 flex items-center justify-center">
              <svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5"
                   class="text-accent" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2"/>
              </svg>
            </div>
          </div>
          <span class="bg-primary text-on-primary px-4 py-1.5 rounded-full text-sm font-semibold inline-block mb-5">
            My Orders
          </span>
          <h1 class="text-3xl lg:text-4xl font-bold text-text mb-4">Order History</h1>
          <p class="text-lg text-text-muted leading-relaxed max-w-md mx-auto">
            Track and manage all your orders and programs in full through the SZAFIT app.
          </p>
        </div>

        <!-- Placeholder order rows (visual skeleton) -->
        <div class="bg-surface border border-border rounded-2xl overflow-hidden shadow-card-resting mb-8">
          {[
            { label: 'VIP Fit Club', weeks: '12 weeks', status: 'Active',    active: true },
            { label: 'Zero to Fit', weeks: '8 weeks',  status: 'Completed', active: false },
          ].map((row) => (
            <div class="flex items-center justify-between gap-4 px-6 py-5 border-b border-border last:border-0">
              <div class="flex items-center gap-4 min-w-0">
                <div class="w-10 h-10 rounded-xl bg-primary/15 flex items-center justify-center shrink-0">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
                       class="text-accent" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <div class="min-w-0">
                  <p class="font-semibold text-text truncate">{row.label}</p>
                  <p class="text-sm text-text-muted">{row.weeks}</p>
                </div>
              </div>
              <span class={`shrink-0 text-xs font-semibold px-3 py-1 rounded-full ${
                row.active
                  ? 'bg-primary/20 text-accent'
                  : 'bg-surface-soft text-text-muted border border-border'
              }`}>
                {row.status}
              </span>
            </div>
          ))}

          <!-- Locked row hinting at more -->
          <div class="px-6 py-5 flex items-center justify-center gap-2 text-sm text-text-muted bg-surface-soft/60">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"
                 viewBox="0 0 24 24" class="shrink-0">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>Sign in via the app to view your full order history</span>
          </div>
        </div>

        <!-- CTA row -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href={`/en/`}
            class="inline-flex items-center justify-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-xl font-semibold hover:bg-primary-hover transition-all hover:-translate-y-0.5 shadow-sm"
          >
            Back to Home
          </a>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border border-border bg-surface text-text px-6 py-3 rounded-xl font-semibold hover:border-accent hover:text-accent transition-all hover:-translate-y-0.5"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Contact Support
          </a>
        </div>

      </div>
    </div>
  </main>
</BaseLayout>
