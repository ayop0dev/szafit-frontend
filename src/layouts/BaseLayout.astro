---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../types/wp';

interface Props {
    lang: Lang;
    title?: string;
    currentPath: string;
    showNav?: boolean;
}

const { lang, title = 'SZAFIT', currentPath, showNav = false } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/images/szafit-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Changa:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-base text-text font-sans min-h-screen flex flex-col">
    <Header lang={lang} currentPath={currentPath} showNav={showNav} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
