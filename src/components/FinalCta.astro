---
import type { Lang } from '../types/wp';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const content = {
    ar: {
        title: "جاهزة تضاعفين قوتك؟",
        desc: "احجزي مكالمتك الآن واستعدي لتغيير حقيقي وتدريب مصمم خصيصاً لكِ، كما فعلت العشرات من قبلك.",
        btn: "ابدئي الآن",
    },
    en: {
        title: "Ready to get started?",
        desc: "We typically have what you need to start your transformation. Join dozens of others who achieved their goals.",
        btn: "Get Started",
    }
};

const c = content[lang];
const isRtl = lang === 'ar';

const avatars = [
    { src: 'https://randomuser.me/api/portraits/women/33.jpg', top: '15%', left: '10%', size: 'w-12 h-12 lg:w-16 lg:h-16', delay: '0s' },
    { src: 'https://randomuser.me/api/portraits/women/47.jpg', top: '65%', left: '15%', size: 'w-10 h-10 lg:w-14 lg:h-14', delay: '1s' },
    { src: 'https://randomuser.me/api/portraits/women/12.jpg', top: '25%', left: '80%', size: 'w-14 h-14 lg:w-20 lg:h-20', delay: '2s' },
    { src: 'https://randomuser.me/api/portraits/women/5.jpg', top: '75%', left: '75%', size: 'w-12 h-12 lg:w-16 lg:h-16', delay: '0.5s' },
    { src: 'https://randomuser.me/api/portraits/women/68.jpg', top: '80%', left: '35%', size: 'w-8 h-8 lg:w-12 lg:h-12', delay: '1.5s' },
    { src: 'https://randomuser.me/api/portraits/women/44.jpg', top: '10%', left: '60%', size: 'w-10 h-10 lg:w-14 lg:h-14', delay: '2.5s' },
];
---

<section class="relative py-24 lg:py-36 overflow-hidden bg-surface-soft border-t border-border flex items-center justify-center">
    
    <!-- Decorative Blobs/Gradients -->
    <div class="absolute inset-0 z-0 opacity-40">
        <div class="absolute top-0 -left-20 w-72 h-72 bg-primary/30 rounded-full mix-blend-multiply filter blur-3xl animate-blob"></div>
        <div class="absolute top-20 -right-20 w-72 h-72 bg-accent/20 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"></div>
        <div class="absolute -bottom-20 left-1/2 -translate-x-1/2 w-72 h-72 bg-primary/20 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-4000"></div>
    </div>

    <!-- Floating Avatars -->
    {avatars.map(avatar => (
        <img 
            src={avatar.src} 
            alt="User avatar" 
            class={`absolute rounded-full object-cover shadow-lg border-[3px] border-surface z-10 animate-float ${avatar.size}`}
            style={`top: ${avatar.top}; left: ${avatar.left}; animation-delay: ${avatar.delay};`}
            onerror="this.style.display='none'"
        />
    ))}

    <!-- Content -->
    <div class="relative z-20 text-center max-w-2xl mx-auto px-6 animate-fade-up">
        <h2 class="text-[40px] lg:text-[54px] font-[900] mb-6 leading-[1.1] text-text tracking-tight">{c.title}</h2>
        <p class="text-[16px] lg:text-[18px] text-text-muted mb-10 leading-[1.7] font-[500] max-w-[500px] mx-auto">{c.desc}</p>
        
        <a href="https://wa.me/+966550150445" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-text text-surface px-8 py-4 rounded-full font-[800] text-lg hover:scale-105 transition-transform shadow-[0_10px_30px_rgba(0,0,0,0.1)] w-full sm:w-auto group">
            {c.btn}
            <!-- Arrow Icon depending on RTL or LTR -->
            {isRtl ? (
                <svg class="w-5 h-5 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            ) : (
                <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            )}
        </a>
    </div>
</section>

<style>
    .animate-blob {
        animation: blob 7s infinite;
    }
    .animation-delay-2000 {
        animation-delay: 2s;
    }
    .animation-delay-4000 {
        animation-delay: 4s;
    }
    @keyframes blob {
        0% { transform: translate(0px, 0px) scale(1); }
        33% { transform: translate(30px, -50px) scale(1.1); }
        66% { transform: translate(-20px, 20px) scale(0.9); }
        100% { transform: translate(0px, 0px) scale(1); }
    }
    
    .animate-float {
        animation: float 6s ease-in-out infinite;
    }
    @keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
        100% { transform: translateY(0px); }
    }
</style>
