---
import { getSiteSettings } from '../lib/content';
import type { Lang } from '../types/wp';
import AppStoreButtons from './AppStoreButtons.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';
const siteSettings = getSiteSettings();

const navLinks = isAr
    ? [
        { href: `/${lang}/programs/`, label: 'البرامج' },
        { href: `/${lang}/about/`, label: 'عنا' },
        { href: `/${lang}/contact/`, label: 'تواصل' },
        { href: `/${lang}/privacy/`, label: 'الخصوصية' },
        { href: `/${lang}/terms/`, label: 'الشروط' },
    ]
    : [
        { href: `/${lang}/programs/`, label: 'Programs' },
        { href: `/${lang}/about/`, label: 'About' },
        { href: `/${lang}/contact/`, label: 'Contact' },
        { href: `/${lang}/privacy/`, label: 'Privacy' },
        { href: `/${lang}/terms/`, label: 'Terms' },
    ];

type SocialEntry = { href: string; label: string; icon: string };
const socialLinks: SocialEntry[] = (
    [
        siteSettings.socialLinks.instagram && { href: siteSettings.socialLinks.instagram, label: 'Instagram', icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>' },
        siteSettings.socialLinks.twitter   && { href: siteSettings.socialLinks.twitter,   label: 'Twitter', icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>' },
        siteSettings.socialLinks.tiktok    && { href: siteSettings.socialLinks.tiktok,    label: 'TikTok', icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>' },
        siteSettings.socialLinks.youtube   && { href: siteSettings.socialLinks.youtube,   label: 'YouTube', icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/></svg>' },
    ] as (SocialEntry | false)[]
).filter((x): x is SocialEntry => Boolean(x));

const copyright = isAr
    ? '© 2026 SZAFIT. جميع الحقوق محفوظة.'
    : '© 2026 SZAFIT. All rights reserved.';
---
<footer class="border-t border-border bg-base py-10 mt-auto">
  <div class="max-w-container mx-auto px-6 flex flex-col gap-8">

    <!-- Branding + app buttons + page nav -->
    <div class="flex flex-col md:flex-row items-center justify-center md:justify-between gap-6 text-center md:text-start">
      <!-- Logo -->
      <div class="flex justify-center md:justify-start">
        <a href={`/${lang}/`} class="inline-block transition-transform hover:scale-105">
          <img src="/assets/images/szafit-logo.png" alt="SZAFIT" class="h-8 lg:h-10 w-auto" />
        </a>
      </div>

      <!-- Nav Links -->
      <nav
        aria-label={isAr ? 'روابط الصفحات' : 'Page links'}
        class="flex flex-wrap justify-center flex-1 gap-x-6 gap-y-3 text-text-muted text-sm"
      >
        {navLinks.map((link) => (
          <a href={link.href} class="hover:text-primary-green transition-colors">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- App Store Buttons -->
      <div class="flex justify-center md:justify-end shrink-0" style="transform: scale(0.6); transform-origin: center;">
        <AppStoreButtons />
      </div>
    </div>

    <!-- Social links + copyright -->
    <div class="flex flex-col sm:flex-row items-center justify-center sm:justify-between gap-6 sm:gap-4 border-t border-border pt-6 text-center sm:text-start">
      {socialLinks.length > 0 && (
        <nav
          aria-label={isAr ? 'روابط التواصل الاجتماعي' : 'Social media links'}
          class="flex flex-wrap justify-center sm:justify-start gap-5 text-text-muted text-sm"
        >
          {socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-primary-green transition-colors">
              <span set:html={link.icon} class="shrink-0" />
              <span>{link.label}</span>
            </a>
          ))}
        </nav>
      )}
      <p class="text-xs text-text-muted mt-2 sm:mt-0">{copyright}</p>
    </div>

  </div>
</footer>
