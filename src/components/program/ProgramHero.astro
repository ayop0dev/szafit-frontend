---
import type { WpProgram, LocalizedProgram, Lang } from '../../types/wp';
import { formatPrice } from '../../utils/i18n';

interface Props {
    program: WpProgram;
    localized: LocalizedProgram;
    lang: Lang;
    checkoutHref: string;
    archiveHref: string;
}

const { program, localized, lang, checkoutHref, archiveHref } = Astro.props;
const priceLabel = formatPrice(program.price, program.currency, lang);

const copy = {
    ar: {
        investment: "الاستثمار في صحتك",
        subscribe: localized?.ctaLabel || "اشترك الآن",
        back: "← العودة للبرامج",
        features: [
            { icon: "check", text: "تخصيص كامل" },
            { icon: "shield", text: "متابعة دقيقة" },
            { icon: "target", text: "نتائج سريعة" },
            { icon: "bolt", text: "طاقة عالية" }
        ]
    },
    en: {
        investment: "Invest in your health",
        subscribe: (localized?.ctaLabel && localized.ctaLabel !== '') ? localized.ctaLabel : "Subscribe Now",
        back: "← Back to Programs",
        features: [
            { icon: "check", text: "Fully Customized" },
            { icon: "shield", text: "Close Monitoring" },
            { icon: "target", text: "Fast Results" },
            { icon: "bolt", text: "High Energy" }
        ]
    }
};

const c = lang === 'ar' ? copy.ar : copy.en;
---
<section class="max-w-container mx-auto px-6 mt-[20px] fade-target">
    <!-- Wrapping div for both the Hero card and the overlapping strip -->
    <div class="relative w-full mb-20 lg:mb-28">
        
        <!-- Background Image Container (Hero Card) -->
        <div class="relative w-full h-[550px] lg:h-[650px] rounded-[32px] overflow-hidden shadow-card-resting group">
            <img src={localized.image} alt={localized.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" onerror="this.style.display='none'">
            <!-- Adjusted gradient for better readability on both sides -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/60"></div>
            
            <div class="absolute inset-0 p-8 lg:p-12 flex flex-col justify-between">
                <!-- Top Row: Badge and Title (Right aligned in AR) -->
                <div class="flex flex-col items-start w-full" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
                    <span class="bg-primary text-on-primary px-5 py-2 rounded-full text-sm lg:text-base font-bold mb-4 shadow-sm">{localized.tag}</span>
                    <h1 class="text-5xl lg:text-[72px] font-black text-white max-w-3xl leading-[1.1]">{localized.title}</h1>
                </div>

                <!-- Bottom Row: Desc and Price -->
                <div class="flex flex-col md:flex-row justify-between items-end gap-8 w-full pb-8 md:pb-12" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
                    
                    <!-- Description (Element 1: Start in RTL -> Right) -->
                    <div class="w-full md:w-[55%]">
                        <p class="text-white/95 text-xl lg:text-2xl font-semibold leading-relaxed drop-shadow-md">
                            {localized.shortDescription}
                        </p>
                    </div>

                    <!-- Price Box (Element 2: End in RTL -> Left) -->
                    <div class="flex flex-col gap-3 w-full md:w-auto md:min-w-[300px] items-start bg-neutral-dark-1/70 backdrop-blur-md p-8 rounded-3xl border border-white/20 shadow-2xl">
                        <p class="text-white/80 text-sm lg:text-base font-medium">{c.investment}</p>
                        <div class="flex items-baseline gap-2" dir="ltr">
                            <span class="text-primary text-xl font-bold" set:html={program.currency === 'SAR' ? '<span class="inline-block w-[0.9em] h-[1em] align-middle bg-current translate-y-[-2px]" style="-webkit-mask: url(/assets/Saudi_Riyal_Symbol-2.svg) no-repeat center; -webkit-mask-size: contain; mask: url(/assets/Saudi_Riyal_Symbol-2.svg) no-repeat center; mask-size: contain;" aria-label="SAR"></span>' : program.currency}></span>
                            <span class="text-primary text-5xl lg:text-6xl font-black tracking-wider">{program.price}</span>
                        </div>
                        <a href={checkoutHref} class="bg-primary text-neutral-dark-1 px-8 py-4 rounded-xl text-center font-black text-xl hover:bg-primary-green-light shadow-sm transition-transform hover:-translate-y-1 w-full mt-4">
                            {c.subscribe}
                        </a>
                    </div>

                </div>
            </div>
        </div> <!-- End Hero Card -->
        
        <!-- The White Strip of Features overlapping the image -->
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 w-[95%] lg:w-[85%] bg-surface rounded-[24px] shadow-[0_15px_50px_rgba(0,0,0,0.2)] p-4 lg:p-6 z-20 border border-border">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 divide-y md:divide-y-0 md:divide-x divide-border rtl:divide-x-reverse" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
                {c.features.map((feature) => (
                    <div class="flex items-center justify-center gap-3 py-3 md:py-2">
                        <div class="w-12 h-12 rounded-full bg-primary/20 text-text flex items-center justify-center shrink-0">
                            {feature.icon === 'check' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>}
                            {feature.icon === 'shield' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
                            {feature.icon === 'target' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>}
                            {feature.icon === 'bolt' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>}
                        </div>
                        <span class="text-text font-bold text-base lg:text-lg">{feature.text}</span>
                    </div>
                ))}
            </div>
        </div>
        
    </div> <!-- End Wrapping div -->
</section>
