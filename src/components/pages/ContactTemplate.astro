---
import type { Lang } from '../../types/wp';
import { getPageContent, getSiteSettings } from '../../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';

const contactContent = getPageContent('contact');
const siteSettings = getSiteSettings();

const c = {
  title: isAr ? contactContent.titleAr : (contactContent as any).titleEn,
  body: isAr ? contactContent.bodyAr : (contactContent as any).bodyEn,
};

const copy = {
  ar: {
    welcome: 'يسعدني تواصلكم ومتابعتكم على حساباتي في منصات التواصل الاجتماعي. انضموا لعائلة SZAFIT الآن!',
    followUs: 'تابعونا وتواصلوا معنا:',
  },
  en: {
    welcome: 'I am delighted to connect with you and have you follow my social media accounts. Join the SZAFIT family now!',
    followUs: 'Follow & Connect with us:',
  }
};

const t = copy[lang];
---

<div class="max-w-5xl mx-auto py-12 lg:py-20 px-6" dir={isAr ? 'rtl' : 'ltr'}>
  <div class="bg-surface border border-border rounded-3xl overflow-hidden shadow-2xl flex flex-col lg:flex-row">
    
    <!-- Image Half -->
    <div class="lg:w-1/2 relative h-[400px] lg:h-auto order-1 lg:order-2">
      <img src="/assets/images/coach-sza/coach-sza (5).webp" alt="Coach SZA Contact" class="absolute inset-0 w-full h-full object-cover object-top" />
      <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent lg:hidden"></div>
    </div>
    
    <!-- Content Half -->
    <div class="lg:w-1/2 p-8 lg:p-12 xl:p-16 flex flex-col justify-center relative z-10 order-2 lg:order-1">
      <h1 class="text-3xl lg:text-4xl font-bold text-text mb-6">{c.title}</h1>
      
      <div class="text-base lg:text-lg text-text-muted leading-relaxed mb-8">
        <p class="mb-4">{c.body}</p>
        <p class="font-medium text-text">{t.welcome}</p>
      </div>
      
      <div class="mt-4">
        <h3 class="text-sm font-bold text-text uppercase tracking-wider mb-6">{t.followUs}</h3>
        <div class="flex items-center gap-4">
          {siteSettings.socialLinks.instagram && (
            <a 
              href={siteSettings.socialLinks.instagram} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="bg-base hover:bg-primary hover:text-neutral-dark-3 w-14 h-14 rounded-full flex items-center justify-center text-text transition-transform hover:-translate-y-1 shadow-lg border border-border"
              aria-label="Instagram"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
              </svg>
            </a>
          )}
          {siteSettings.socialLinks.tiktok && (
            <a 
              href={siteSettings.socialLinks.tiktok} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="bg-base hover:bg-primary hover:text-neutral-dark-3 w-14 h-14 rounded-full flex items-center justify-center text-text transition-transform hover:-translate-y-1 shadow-lg border border-border"
              aria-label="TikTok"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
    
  </div>
</div>
