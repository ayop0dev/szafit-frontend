---
import type { WpProgram } from '../types/wp';
import type { Lang } from '../types/wp';
import { getLocalizedProgram } from '../lib/content';
import { formatPrice } from '../utils/i18n';

interface Props {
    program: WpProgram;
    lang: Lang;
}

const { program, lang } = Astro.props;
const localized = getLocalizedProgram(program, lang);
const priceLabel = formatPrice(program.price, program.currency, lang);
const detailsHref = `/${lang}/programs/${program.slug}/`;
const checkoutHref = `/${lang}/checkout/?program=${program.slug}`;

const copy = {
    ar: {
        checkoutCta: "اشترك",
        missingImage: "صورة البرنامج غير متوفرة"
    },
    en: {
        checkoutCta: "Subscribe",
        missingImage: "Program image unavailable"
    }
};

const c = lang === 'ar' ? copy.ar : copy.en;
---
<article class="bg-surface rounded-[20px] shadow-card-resting hover:shadow-card-hover hover:-translate-y-1 transition-all duration-300 flex flex-col overflow-hidden animate-fade-up">
    <a href={detailsHref} class="block relative aspect-video overflow-hidden bg-border flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
        <span class="text-text-muted text-xs font-medium px-4 text-center" aria-hidden="true">
            {c.missingImage}
        </span>
        
        {localized.image && (
            <img 
                src={localized.image} 
                alt={localized.title} 
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 hover:scale-105" 
                onerror="this.style.display='none'"
            />
        )}
    </a>
    
    <div class="p-6 flex flex-col flex-1" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
        <div class="bg-primary text-on-primary text-[12px] px-3 py-1 rounded-full self-start font-semibold mb-4 flex items-center gap-1 shadow-sm">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l-7 10h4l-1 10 7-10H11z"/></svg>
            {localized.tag}
        </div>
        
        <h3 class="text-[20px] lg:text-[24px] font-[700] text-text mb-2">
            <a href={detailsHref} class="hover:text-accent transition-colors">{localized.title}</a>
        </h3>
        
        <p class="text-[16px] text-text-muted mb-6 line-clamp-2 leading-[1.65]">
            {localized.shortDescription}
        </p>
        
        <div class="mt-auto pt-4 border-t border-border flex items-center justify-between">
            <span class="text-[20px] font-bold text-text flex items-center gap-1" dir="ltr" set:html={priceLabel}></span>
            <a href={checkoutHref} class="bg-primary text-on-primary px-4 py-2 rounded-xl text-[14px] font-semibold hover:bg-primary-hover transition-colors shadow-sm shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                {c.checkoutCta}
            </a>
        </div>
    </div>
</article>
